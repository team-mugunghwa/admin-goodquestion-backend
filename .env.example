# 서비스 백엔드(goodquestion-backend)와 같은 DB를 가리킨다.
# 관리자가 고친 내용이 그대로 프로덕션 앱에 보여야 하므로 별도 DB를 쓰지 않는다.
DB_URL=jdbc:postgresql://localhost:5432/goodquestion
DB_USERNAME=
DB_PASSWORD=

# 관리자 토큰 서명 키. 아래 명령으로 만들어 그 결과를 붙여 넣는다.
#
#   openssl rand -base64 32
#
# HS256 서명이라 32바이트 이상이어야 한다. 짧으면 기동할 때 걸러 준다.
# 서비스의 JWT_SECRET과 반드시 다른 값을 쓴다. 같으면 보호자 토큰으로 관리자 API가 열린다.
ADMIN_JWT_SECRET=
# 액세스 토큰 만료(ms). 미설정 시 30분
ADMIN_JWT_EXPIRATION_MS=1800000
# 리프레시 토큰 만료(ms). 미설정 시 12시간
ADMIN_JWT_REFRESH_EXPIRATION_MS=43200000

# 관리자 콘솔 오리진. 콤마로 구분. 미설정 시 localhost와 Vercel 배포 주소
CORS_ALLOWED_ORIGIN_PATTERNS=

# FCM 서비스 계정 JSON. 파일 경로(/etc/secrets/fcm.json)나 JSON 원문 모두 받는다.
# 비우면 푸시 발송기가 로그만 남기는 구현으로 대체된다 - 알림 자체는 DB에 쌓이므로
# 사용자는 앱 안에서 답변 알림을 볼 수 있다.
FCM_CREDENTIALS=
# 서비스 계정 JSON에 project_id가 있으면 생략해도 된다.
FCM_PROJECT_ID=

# 알림을 눌렀을 때 도착할 프로덕션 서비스 주소
SERVICE_BASE_URL=http://localhost:7357
